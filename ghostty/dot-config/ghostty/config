# Font
font-family = MonoLisa
font-size = 12
font-style = Medium
font-style-bold = Bold
font-style-italic = Medium Italic
font-style-bold-italic = Bold Italic
font-thicken = true

# Theme
theme = "Ayu Mirage"

# Cursor
cursor-style = block
cursor-style-blink = true
cursor-click-to-move = true

# Window
window-padding-x = 12
window-padding-y = 12
background-opacity = 1.0
adjust-cell-height = 5%

# Behavior
working-directory = home
window-inherit-working-directory = false

# Shell integration
shell-integration = detect
shell-integration-features = cursor,sudo,title,ssh-env,ssh-terminfo

# Splits & tabs
confirm-close-surface = false
unfocused-split-opacity = 0.7

# Scrollback
scrollback-limit = 30000000

# Terminal features
mouse-hide-while-typing = true
copy-on-select = false
app-notifications = no-clipboard-copy,no-config-reload

# Keybinds
keybind = ctrl+shift+n=new_window
keybind = ctrl+t=new_tab
keybind = ctrl+plus=increase_font_size:1
keybind = ctrl+minus=decrease_font_size:1
keybind = ctrl+zero=reset_font_size
keybind = shift+enter=text:\n
keybind = alt+h=goto_split:left
keybind = alt+j=goto_split:bottom
keybind = alt+k=goto_split:top
keybind = alt+l=goto_split:right
keybind = alt+shift+h=new_split:left
keybind = alt+shift+j=new_split:down
keybind = alt+shift+k=new_split:up
keybind = alt+shift+l=new_split:right

# DMS specific overrides
config-file = ?dms
config-file = ?extra
